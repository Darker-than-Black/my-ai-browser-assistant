{
  "manifest_version": 3,
  "name": "MAD — My assistant Dima",
  "version": "0.1.0",
  "description": "😺 Твій котик-помічник у бічній панелі: читає сторінку, відповідає й може сам клікати та заповнювати форми.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabs",
    "tabGroups",
    "debugger"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Відкрити MAD — помічника Діми 😺",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
